# Frontend environment (copy to .env.local; per-machine, gitignored).
# NEXT_PUBLIC_* values are baked at build time.

# Where the Next dev server proxies /api/* to.
BACKEND_URL=http://127.0.0.1:8011

# The app's public origin when the landing lives on another domain
# (e.g. https://app.stockai.es). Empty keeps every link relative.
NEXT_PUBLIC_APP_URL=

# The landing's public origin: canonical URLs, sitemap, og:image
# (e.g. https://stockai.es).
NEXT_PUBLIC_SITE_URL=

# Google Search Console ownership token: the content="..." value of the
# "HTML tag" verification method. Empty renders no tag.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
