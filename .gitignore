# OS
.DS_Store
Thumbs.db
desktop.ini

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
logs/

# Backend runtime storage (dataset uploads, model artifacts, indexed documents)
storage/
backend/storage/

# Runtime artifacts written by the forecasting engine
registry.json

# TypeScript incremental build info
*.tsbuildinfo

# Claude Code local settings (machine-specific: settings.local.json, worktrees,
# locks). Skills are the exception — they are project knowledge and belong to
# whoever clones this, not to one machine. `.claude/*` rather than `.claude/`
# so git still descends into the directory; it will not look inside an excluded
# directory, and the negation below would never be reached.
.claude/*
!.claude/skills/

# Personal notes / memory
memory/

# MCP config (contains project refs)
.mcp.json

# Build copies created by faro_prep_build
ForecastingCore/faro_prep_build/forecastlib/
ForecastingCore/faro_prep_build/build/
ForecastingCore/faro_prep_build/*.egg-info/

# Local git worktrees (superpowers subagent-driven-development)
.worktrees/
