__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
*.pyc
*.pyo

# Environment / secrets
.env
.env.*
*.env
!.env.example
secrets.json

# Node / Frontend
node_modules/
.next/
out/
.nuxt/

# IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
