# Landing on its own domain, app on a subdomain.
#   CADDYFILE=Caddyfile.split  LANDING_DOMAIN=stockai.es  DOMAIN=app.stockai.es
#   APP_URL=https://app.stockai.es   (baked into the frontend build)
#
# One Next.js server behind both. The landing domain serves "/" and the static
# files the landing itself loads; any other path is an app route and is sent to
# the app's origin, so a bookmarked stockai.es/compras still lands somewhere
# real. On the app domain "/" is the landing, so it goes to /login instead —
# which already forwards a signed-in user into the app.

# Extra sites from other projects on this VPS live in /etc/caddy/extra (a host directory
# mounted read-only by docker-compose.prod.yml). Importing a glob that matches nothing is not an error.
import /etc/caddy/extra/*.caddy

{$LANDING_DOMAIN}, www.{$LANDING_DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"

	@www host www.{$LANDING_DOMAIN}
	redir @www https://{$LANDING_DOMAIN}{uri} 308

	# The landing's own pages (Frontend/src/app/{precios,como-funciona,...}) are
	# listed by name: anything not named here is an app route. The English site
	# (/en, /en/pricing, ..., Frontend/src/components/landing/sitePaths.ts) is
	# listed the same way; /en/ is named so Next 308s it to /en on this domain
	# instead of it being sent to the app domain.
	@landing path / /precios /como-funciona /preguntas-frecuentes /seguridad /desarrolladores /industrias /industrias/consumo-masivo /industrias/ferreteria /industrias/farmacia /industrias/autopartes /industrias/retail /stockai-vs-excel /como-se-calcula /que-es-stockai /software-de-inventario-para-distribuidores /como-calcular-el-punto-de-reorden /stock-de-seguridad /pronostico-de-demanda-para-compras /integraciones /novedades /privacidad /terminos /cookies /aviso-legal /legal /uso-aceptable /procesamiento-de-datos /ia /divulgacion-responsable /accesibilidad /condiciones-comerciales /licencia /.well-known/* /docs /docs/* /en /en/ /en/pricing /en/how-it-works /en/faq /en/security /en/developers /en/industries /en/industries/consumer-goods /en/industries/hardware /en/industries/pharmacy /en/industries/auto-parts /en/industries/retail /en/stockai-vs-excel /en/how-it-is-calculated /en/integrations /en/whats-new /en/what-is-stockai /en/inventory-software-for-distributors /en/how-to-calculate-the-reorder-point /en/safety-stock /en/demand-forecasting-for-purchasing /en/privacy /en/terms /en/cookies /en/legal-notice /en/acceptable-use /en/data-processing /en/ai /en/responsible-disclosure /en/accessibility /en/commercial-terms /en/license /en/legal /en/docs /en/docs/* /api-response-examples.json /icon.svg /_next/* /*.png /*.jpg /*.svg /*.ico /*.webp /*.pdf /*.csv /*.txt /*.xml /*.webmanifest /google*.html
	handle @landing {
		reverse_proxy frontend:5000
	}
	handle {
		redir https://{$DOMAIN}{uri} 308
	}
}

{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	redir / /login 302
	reverse_proxy frontend:5000
}
