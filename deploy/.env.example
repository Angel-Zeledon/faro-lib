# Production environment for docker-compose.prod.yml — copy to deploy/.env.
# This file feeds api, worker and worker-extra via env_file. Compose-level
# variables (DOMAIN, POSTGRES_PASSWORD) are read from here too.

# ── Public entry ──────────────────────────────────────────────────────────────
# Domain Caddy serves and gets TLS certificates for (DNS must point here).
DOMAIN=app.example.com
FRONTEND_URL=https://app.example.com
ALLOWED_ORIGINS=["https://app.example.com"]

# Optional: landing on its own domain, app on DOMAIN (e.g. stockai.es and
# app.stockai.es). Both must point at this server. Leave the three empty to
# serve landing and app together on DOMAIN.
#   CADDYFILE=Caddyfile.split
#   LANDING_DOMAIN=stockai.es
#   APP_URL=https://app.stockai.es
# ── Security ──────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
ENVIRONMENT=production
TESTING_MODE=false

# Who may open /instalacion and change this deployment's services from the app.
# `admin` is a role INSIDE a tenant — every company that signs up has one — so
# it cannot be what grants deployment-wide access. Put your own address here.
# Empty means nobody edits service configuration from the app and everything
# below is read-only in the panel, which is the safe default but leaves you
# editing this file and redeploying for every key.
INSTANCE_ADMIN_EMAILS=you@example.com

# ── Database ──────────────────────────────────────────────────────────────────
# Bundled Postgres (--profile bundled-db): leave DATABASE_URL as-is and set
# only POSTGRES_PASSWORD (must match the URL).
# Managed Postgres: point DATABASE_URL at it and start WITHOUT the profile.
POSTGRES_PASSWORD=change-me-too
DATABASE_URL=postgresql://faro:change-me-too@db:5432/faro

# ── AI ───────────────────────────────────────────────────────────────────────
# DeepSeek is the ONLY backend for chat, RAG, the narrative and the
# data-quality diagnosis. There is no fallback provider and no local model:
# leave this empty and every AI feature raises at the point of use.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# ── How a customer reaches you to lift the free tier's limits ────────────────
# There is no checkout in StockAI: the free tier's ceilings are lifted by hand,
# after a conversation. These three ARE the commercial surface.
#
# Leave them empty and the app hides its "write to us" buttons — a tenant that
# hits a ceiling then has no way out, and the in-app upgrade request lands in
# `upgrade_requests` with a warning in the log and no email to anybody. Someone
# trying to pay you becomes a row nobody reads.
#
#   CONTACT_WHATSAPP     - E.164 WITHOUT the '+', the way wa.me wants it
#   CONTACT_EMAIL        - the address the "write to us" button opens
#   UPGRADE_NOTIFY_EMAIL - where in-app upgrade requests are mailed
#                          (falls back to CONTACT_EMAIL when empty)
CONTACT_WHATSAPP=50600000000
CONTACT_EMAIL=hola@example.com
UPGRADE_NOTIFY_EMAIL=hola@example.com

# ── Email (Resend primary, SMTP fallback; both empty = logged no-ops) ────────
RESEND_API_KEY=re_...
EMAIL_FROM=StockAI <onboarding@resend.dev>
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Twilio (WhatsApp/SMS; empty = logged no-ops) ─────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+14155238886
# Public base URL Twilio signs inbound webhooks against (scheme + host).
WHATSAPP_WEBHOOK_BASE_URL=https://app.example.com

# ── RAG (optional) ────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX=
VOYAGEAI_API_KEY=

# ── Secret storage (recommended) ─────────────────────────────────────────────
# Fernet key for every secret /instalacion stores. Leave it empty and the
# deployment generates one into <STORAGE_PATH>/instance_secret.key on first
# use — which works, but must then be backed up with storage/ and copied here
# before a second process runs on another volume.
INTEGRATIONS_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Everything below "Security" is OPTIONAL and can also be set from the app at
# /instalacion, which stores it encrypted in the database and takes effect
# without a redeploy. The stored value WINS over this file, and the panel says
# which one is in effect for every field.
#
# What is NOT editable from the app, on purpose: SECRET_KEY, DATABASE_URL,
# FRONTEND_URL, ALLOWED_ORIGINS, INSTANCE_ADMIN_EMAILS, INTEGRATIONS_SECRET_KEY
# and the deployment switches. They are read at boot, or they protect the very
# rows the panel writes.
#
# The full reference — every variable, and exactly what stops working without
# it — is `docs/configuration.md`, generated from the same source as this file.
