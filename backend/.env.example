# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Application security ──────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── SMTP (email verification / password reset) ────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ── Pinecone (RAG vector store) ───────────────────────────────────────────────
PINECONE_API_KEY=pcsk_...
PINECONE_ENVIRONMENT=us-east-1-aws
PINECONE_INDEX=your-index-name          # 1024 dims, cosine, serverless

# ── Database (Supabase PostgreSQL) ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@db.<project>.supabase.co:5432/postgres

# ── Frontend URL (CORS origin) ────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Voyage AI (embeddings) ────────────────────────────────────────────────────
VOYAGEAI_API_KEY=pa-...

# --- Deployment environment: development | staging | production ---
# In production the server REFUSES to start if TESTING_MODE=true.
ENVIRONMENT=development

# --- Testing mode (bypasses quotas, rate limits and upload caps - NEVER in prod) ---
TESTING_MODE=false

# --- Resend (email transactional - primary transport; SMTP is the fallback) ---
RESEND_API_KEY=re_...
EMAIL_FROM=Faro <onboarding@resend.dev>

# --- Stripe (billing - optional) ---
# With STRIPE_SECRET_KEY unset, the billing endpoints report that billing is not
# configured and nothing else in the app is affected.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. WITHOUT THIS THE WEBHOOK REFUSES TO RUN: an unverified webhook is
# an open endpoint for raising your own plan, so it fails closed rather than
# trusting the request body.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs, created in the Stripe dashboard. A plan with no price here is not
# offered for sale, rather than offered and then failing at checkout. Enterprise
# is quoted per operation and deliberately has none.
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_YEARLY=price_...

# --- Twilio (WhatsApp daily inventory alerts - optional) ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Plain E.164 sender for team-messaging SMS heads-ups (the whatsapp: sender cannot send SMS)
TWILIO_SMS_FROM=+14155238886
