# Generated by backend/scripts/gen_config_docs.py — edit the registry, not this file.
#
# Copy to backend/.env and fill in what you need.
#
# Only the CORE block is required. Every other service is optional: with
# its variables empty the feature reports itself off and says so on the
# screen that would have used it — nothing crashes, nothing pretends.
# Each block below states exactly what stops working.
#
# Everything except CORE and the blocks marked 'environment only' can
# also be set from the app at /instalacion, which stores it encrypted in
# the database and takes effect without a restart. The database value
# wins over this file, and the panel says which one is in effect.

# ──────────────────────────────────────────────────────────────────────────
# CORE — Process identity, database and signing key.
# Without it: Nothing starts. These are read once at boot.
#
# Environment only, on purpose: these are read at import time by the
# connection pool and the JWT signer, so a value written from the panel
# would not take effect until a restart — and a wrong one would prevent the
# restart from succeeding.
#
# Environment only — the panel reports these, never writes them.
# ──────────────────────────────────────────────────────────────────────────
# Signs every access and refresh token. Changing it logs everyone out
# immediately. Use a long random string, never a guessable one.
# (required for this service; secret; environment only)
SECRET_KEY=change-me-to-a-long-random-string

# PostgreSQL connection string. The job queue IS a table in this database,
# so the worker and the API must point at the same one.
# (required for this service; secret; environment only)
DATABASE_URL=postgresql://postgres:password@localhost:5432/faro

# Public base URL of the web app. Every link the backend emails
# (verification, password reset, invitation) is built from it, so a wrong
# value sends working mail to a dead address.
# (required for this service; environment only)
FRONTEND_URL=http://localhost:5000

# CORS origins allowed to call the API from a browser. The frontend's own
# origin must be in the list or every call fails in the browser while
# working perfectly from curl.
# (default: http://localhost:3000, http://localhost:4000,
# http://localhost:5000; environment only)
# ALLOWED_ORIGINS=http://localhost:5000

# Comma-separated addresses allowed to see and edit this instance's service
# configuration. `admin` is a role inside a tenant, so it cannot grant
# deployment-wide access. Empty means nobody edits it from the app — the
# panel becomes read-only for a tenant's own channels and says why.
# (environment only)
# INSTANCE_ADMIN_EMAILS=you@yourcompany.com

# development | staging | production. In production the server REFUSES to
# boot with TESTING_MODE=true.
# (default: development; environment only)
# ENVIRONMENT=development

# Product name in email subjects and the API's OpenAPI title.
# (default: ForecastPlatform; environment only)
# APP_NAME=StockAI

# Version string reported by /health and the OpenAPI document.
# (default: 1.0.0; environment only)
# APP_VERSION=1.0.0

# Access-token lifetime. The frontend refreshes silently, so this is a
# security window, not a UX one.
# (default: 15; environment only)
# ACCESS_TOKEN_EXPIRE_MINUTES=15

# JWT signing algorithm. Leave it at HS256 unless you are also changing the
# key material.
# (default: HS256; environment only)
# ALGORITHM=HS256

# Directory holding uploaded datasets, model artifacts and documents.
# Postgres holds the metadata; these are the bytes. It is NOT in the
# database backup — back it up separately.
# (default: backend/storage; environment only)
# STORAGE_PATH=./storage

# Bypasses ALL quotas, rate limits and upload caps. For load and functional
# testing only. The server refuses to boot with this on when
# ENVIRONMENT=production.
# (default: false; environment only)
# TESTING_MODE=false


# ──────────────────────────────────────────────────────────────────────────
# LLM — DeepSeek — the only LLM backend. Powers every AI feature.
# Without it: The assistant stops answering, the morning narrative and the
# inventory insight fall back to their rule-based text, the RAG analyst goes
# off, and the data-quality diagnosis reports only its deterministic checks.
# Nothing errors: each surface says the assistant is unavailable.
#
# There is exactly one provider and no fallback chain. A previous version
# picked whichever key happened to be set, which meant a typo in the
# variable name produced working AI features answered by a different vendor
# — visible only on the invoice.
# ──────────────────────────────────────────────────────────────────────────
# DeepSeek API key. Without it every AI feature reports itself unavailable
# instead of answering from somewhere else.
# (required for this service; secret)
# DEEPSEEK_API_KEY=sk-...

# 'deepseek-chat' is the cheap general model. 'deepseek-reasoner' costs more
# and returns its reasoning separately.
# (default: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# API base. Point it at a compatible gateway to route through your own proxy
# — the wire format is OpenAI-shaped.
# (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com


# ──────────────────────────────────────────────────────────────────────────
# EMAIL — Transactional email — Resend first, SMTP as the fallback.
# Without it: No email leaves: account verification, password reset,
# invitations, the daily inventory digest, the monthly ROI recap and
# purchase orders sent to suppliers. Each send is logged and reported as not
# delivered — the app never claims it mailed something it did not.
#
# Resend wins when its key is present; SMTP is used otherwise. With neither,
# `_transport_send` RAISES rather than returning quietly: a silent no-op
# here made callers report invitations as sent that nobody ever received. A
# tenant override applies ONLY to mail addressed to that tenant's own people
# and its suppliers. Account-lifecycle mail — verification, password reset,
# invitations — always uses the instance transport, because a tenant must
# not be able to send the message that grants access to an account.
#
# Enough to turn it on: RESEND_API_KEY OR SMTP_USER + SMTP_PASS.
#
# A single tenant may override these from the app with its own sender; what
# is set here is the default for everyone else.
# ──────────────────────────────────────────────────────────────────────────
# Resend API key. When set, Resend is the transport and SMTP is not
# consulted.
# (secret)
# RESEND_API_KEY=re_...

# Sender shown to the recipient. 'onboarding@resend.dev' works without
# domain verification and is fine for a trial; a real deployment should send
# from its own verified domain.
# (default: StockAI <onboarding@resend.dev>)
# EMAIL_FROM=StockAI <onboarding@resend.dev>

# SMTP host for the fallback transport.
# (default: smtp.gmail.com)
# SMTP_SERVER=smtp.gmail.com

# SMTP port. 587 is STARTTLS, which is what the client uses.
# (default: 587)
# SMTP_PORT=587

# SMTP username; also the From address on the SMTP path.
# SMTP_USER=you@example.com

# SMTP password. For Gmail this is an app password, not the account
# password.
# (secret)
# SMTP_PASS=your-app-password


# ──────────────────────────────────────────────────────────────────────────
# WHATSAPP — WhatsApp via Twilio — daily alerts, supplier messages and the bot.
# Without it: No WhatsApp message is sent or received: the daily inventory
# alert loses its WhatsApp channel (email still goes if configured),
# purchase orders cannot be sent to a supplier over WhatsApp, and the
# conversational bot never replies because the webhook has nothing to answer
# with.
#
# `WHATSAPP_WEBHOOK_BASE_URL` is the one that looks optional and is not,
# once the bot is in use. Twilio signs the inbound webhook over the PUBLIC
# url; behind a proxy the backend sees an internal one, the signature never
# matches, and every inbound message is rejected with 403. Empty falls back
# to X-Forwarded-* headers, then to request.url.
#
# A single tenant may override these from the app with its own sender; what
# is set here is the default for everyone else.
#
# Not per tenant, even here: WHATSAPP_WEBHOOK_BASE_URL — they are read
# before the tenant is known.
# ──────────────────────────────────────────────────────────────────────────
# Twilio account SID. Shared with the SMS channel.
# (required for this service; secret)
# TWILIO_ACCOUNT_SID=AC...

# Twilio auth token. Also the key Twilio signs inbound webhooks with, so an
# outdated value rejects incoming messages as well as failing to send.
# (required for this service; secret)
# TWILIO_AUTH_TOKEN=...

# Sender, WITH the 'whatsapp:' prefix. Twilio's sandbox number works for
# testing and only reaches people who joined the sandbox.
# (required for this service)
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public scheme+host Twilio POSTs to, used to rebuild the signed url behind
# a proxy. Set it whenever the bot runs behind TLS termination or the
# frontend proxy.
# WHATSAPP_WEBHOOK_BASE_URL=https://app.example.com

# When true the bot skips the LLM and replies with a fast, honest generic
# message. Confirmations still execute deterministically. A stopgap for when
# no LLM is funded.
# (default: false)
# WHATSAPP_BOT_GENERIC_MODE=false


# ──────────────────────────────────────────────────────────────────────────
# SMS — SMS via Twilio — heads-up for team messages.
# Without it: Team-message heads-ups are not texted. The message itself is
# still delivered in the app; only the SMS nudge is lost.
#
# Shares the Twilio credentials with the WhatsApp service and adds one
# field: the sender. A 'whatsapp:'-prefixed number CANNOT send SMS, which is
# why this is a separate variable and not a reuse.
#
# A single tenant may override these from the app with its own sender; what
# is set here is the default for everyone else.
# ──────────────────────────────────────────────────────────────────────────
# Plain E.164 sender for SMS, without the 'whatsapp:' prefix.
# (required for this service)
# TWILIO_SMS_FROM=+14155238886


# ──────────────────────────────────────────────────────────────────────────
# RAG — Document search — Voyage AI embeddings over a Pinecone index.
# Without it: Uploaded documents stop being indexed and the analyst can no
# longer cite them. The assistant still answers from the tenant's own data;
# it just has no documents to quote.
#
# Needs the `voyageai` and `pinecone` packages installed as well as the keys
# — a missing package disables the service the same way a missing key does,
# and says which. The index must be 1024 dimensions, cosine metric, to match
# the embedding model.
# ──────────────────────────────────────────────────────────────────────────
# Voyage AI key, used to embed both documents and queries.
# (required for this service; secret)
# VOYAGEAI_API_KEY=pa-...

# Pinecone API key for the vector store.
# (required for this service; secret)
# PINECONE_API_KEY=pcsk_...

# Index name. Must be 1024 dims, cosine, serverless.
# (required for this service)
# PINECONE_INDEX=stockai-documents

# Pinecone region. Informational for serverless indexes.
# PINECONE_ENVIRONMENT=us-east-1-aws


# ──────────────────────────────────────────────────────────────────────────
# SECRET_STORAGE — The Fernet key that encrypts every secret `/instalacion` stores.
# Without it: Nothing, immediately — and that is the part worth knowing.
# With the variable unset the deployment GENERATES a key into
# `<STORAGE_PATH>/instance_secret.key`, so the panel keeps saving secrets;
# the state below reads 'not configured' because the variable is empty, not
# because the feature is off, and the panel says which key is in effect.
# What is lost is durability: that file must be backed up with `storage/`,
# and two processes on separate volumes generate DIFFERENT keys and cannot
# read each other's secrets. Only when no key can be written either — a
# read-only disk — does every secret field start refusing, which it does out
# loud rather than storing anything unencrypted.
#
# `INTEGRATIONS_SECRET_KEY` is a Fernet key and is environment-only on
# purpose. It encrypts the secrets this very panel writes, so a panel that
# could rewrite it would make its own stored secrets unreadable with one
# click. Generate it with: python -c "from cryptography.fernet import
# Fernet; print(Fernet.generate_key().decode())" With it unset the
# deployment generates one into `<STORAGE_PATH>/instance_secret.key` on
# first use and logs a WARNING naming the file — which is what makes a
# virgin install usable. Two processes on different volumes then generate
# DIFFERENT keys and cannot read each other's secrets, so promote the
# generated value into this variable before splitting API and worker. Losing
# it means every stored secret must be re-entered. It belongs in your secret
# manager, not in a backup of the database it protects (`deploy/RESTORE.md`
# walks exactly that failure).
#
# Environment only — the panel reports these, never writes them.
# ──────────────────────────────────────────────────────────────────────────
# Fernet key encrypting every secret written from the configuration panel.
# Environment only. The name is historical and kept on purpose: renaming it
# would silently orphan every existing deployment's stored secrets.
# (required for this service; secret; environment only)
INTEGRATIONS_SECRET_KEY=generate-with-fernet-generate-key


# ──────────────────────────────────────────────────────────────────────────
# CONTACT — How a customer reaches you to lift the free tier's ceilings.
# Without it: The 'write to us' buttons disappear. A free tenant that hits a
# ceiling then has no way to ask for more room — which is the entire
# commercial surface of the product, since there is no checkout.
#
# Empty channels are HIDDEN rather than shown broken: a button opening an
# empty wa.me link is worse than no button. Configure at least one.
#
# Enough to turn it on: CONTACT_WHATSAPP OR CONTACT_EMAIL.
# ──────────────────────────────────────────────────────────────────────────
# E.164 without the '+', the way wa.me wants it.
# CONTACT_WHATSAPP=50688887777

# Address the 'write to us' button opens.
# CONTACT_EMAIL=hola@example.com

# Where in-app upgrade requests are emailed. Falls back to CONTACT_EMAIL
# when empty. The request is also stored in `upgrade_requests`, so a failed
# email never loses the ask.
# UPGRADE_NOTIFY_EMAIL=ventas@example.com


# ──────────────────────────────────────────────────────────────────────────
# SOCIAL_LOGIN — Sign in with Google, Apple or Facebook, next to email + password.
# Without it: The 'Continue with Google / Apple / Facebook' buttons
# disappear from the login and signup screens; email + password keeps
# working exactly as before. People who only ever signed in with a provider
# must use 'forgot password' to set one. Off by default — a source install
# shows only the email form until the operator configures a provider AND
# turns SOCIAL_LOGIN_ENABLED on.
#
# Each provider shows its button only when the master switch is on AND every
# one of its fields is set; a half-filled provider is never offered. Every
# provider console asks for the redirect (callback) URL, which is built from
# FRONTEND_URL: <FRONTEND_URL>/api/v1/auth/oauth/google/callback
# <FRONTEND_URL>/api/v1/auth/oauth/facebook/callback
# <FRONTEND_URL>/api/v1/auth/oauth/apple/callback Step-by-step console
# instructions: `docs/social-login.md`. An existing account is linked only
# through an email address the PROVIDER says it verified; when the local
# account had never verified that address, its password is removed on
# linking, because whoever chose it never proved they own the mailbox.
#
# Enough to turn it on: GOOGLE_OAUTH_CLIENT_ID + GOOGLE_OAUTH_CLIENT_SECRET
# OR FACEBOOK_OAUTH_APP_ID + FACEBOOK_OAUTH_APP_SECRET OR
# APPLE_OAUTH_SERVICE_ID + APPLE_OAUTH_TEAM_ID + APPLE_OAUTH_KEY_ID +
# APPLE_OAUTH_PRIVATE_KEY.
# ──────────────────────────────────────────────────────────────────────────
# Master switch. False hides every social button without deleting the
# credentials below, so the feature can be paused and resumed.
# (default: false)
# SOCIAL_LOGIN_ENABLED=false

# OAuth client ID of a 'Web application' client in Google Cloud Console.
# Authorized redirect URI: <FRONTEND_URL>/api/v1/auth/oauth/google/callback.
# GOOGLE_OAUTH_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Client secret of that Google OAuth client. Without it (or the ID) the
# Google button is not shown.
# (secret)
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...

# App ID of a Meta app with the Facebook Login product. Valid OAuth redirect
# URI: <FRONTEND_URL>/api/v1/auth/oauth/facebook/callback.
# FACEBOOK_OAUTH_APP_ID=123456789012345

# App secret of that Meta app. Also signs every Graph API call
# (appsecret_proof). Without it the Facebook button is not shown.
# (secret)
# FACEBOOK_OAUTH_APP_SECRET=0123456789abcdef0123456789abcdef

# Identifier of the Sign in with Apple SERVICES ID (not the App ID). Return
# URL: <FRONTEND_URL>/api/v1/auth/oauth/apple/callback. Apple only accepts
# https return URLs.
# APPLE_OAUTH_SERVICE_ID=es.stockai.signin

# 10-character Apple Developer Team ID; the issuer of the client secret this
# server signs for every Apple sign-in.
# APPLE_OAUTH_TEAM_ID=ABCDE12345

# Key ID of the Sign in with Apple private key (.p8).
# APPLE_OAUTH_KEY_ID=XYZ987WXYZ

# Contents of the .p8 key file, BEGIN/END lines included. Pasted on one line
# is fine; the line breaks are restored. Without it Apple cannot be asked
# for a token and its button is not shown.
# (secret)
# APPLE_OAUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----


# ──────────────────────────────────────────────────────────────────────────
# INBOUND_EMAIL — Receive sales files forwarded by e-mail to a private per-account address.
# Without it: The 'Sales by e-mail' card says this installation cannot
# receive e-mail yet, and POST /api/v1/inbound/email answers a structured
# `inbound_email_disabled` error. Everything else keeps working: files are
# still uploaded by hand.
#
# Needs a mail provider that can forward inbound mail to a webhook
# (Postmark, Mailgun, Resend or any relay) and an MX record for the inbound
# domain. The webhook is authenticated by INBOUND_EMAIL_SECRET: either an
# `X-StockAI-Signature` HMAC header or HTTP Basic auth whose password is the
# secret. Step by step: `docs/inbound-email.md`.
#
# Environment only — the panel reports these, never writes them.
# ──────────────────────────────────────────────────────────────────────────
# Domain the per-account addresses live on (sales+<token>@<domain>). Its MX
# record must point at your inbound mail provider.
# (required for this service; environment only)
# INBOUND_EMAIL_DOMAIN=in.example.com

# Shared secret that authenticates the provider's webhook calls. Use a long
# random string; changing it requires updating the provider's webhook
# settings too.
# (required for this service; secret; environment only)
# INBOUND_EMAIL_SECRET=change-me-to-a-long-random-string


# ──────────────────────────────────────────────────────────────────────────
# WORKER — Background training worker and the scheduled-job loops.
# Without it: With the worker off, training sessions queue forever: they are
# accepted and never run. With the scheduler off, the 8:00 UTC inventory
# alert, the scheduled recalculations and the monthly snapshot never fire.
#
# Both default to true so a bare `uvicorn backend.main:app` behaves like the
# single-process dev setup. In a split deployment the API container sets
# both false and one dedicated worker container runs the loops.
# SCHEDULER_ENABLED must be true in EXACTLY ONE instance. Two schedulers
# send every daily alert twice, and the second one is indistinguishable from
# a bug in the alert.
#
# Environment only — the panel reports these, never writes them.
# ──────────────────────────────────────────────────────────────────────────
# Runs the job-claim/training loop in this process.
# (default: true; environment only)
# WORKER_ENABLED=true

# Runs the cron loops: scheduled jobs, daily alerts, monthly snapshot.
# Exactly one instance may have this on.
# (default: true; environment only)
# SCHEDULER_ENABLED=true

# Identity used to claim jobs and to recover this instance's orphaned
# RUNNING jobs after a crash. Empty falls back to the host name — give a
# long-lived worker a FIXED id so its orphans are still recognised after the
# container is recreated.
# (environment only)
# WORKER_ID=worker-1

# Training jobs this worker runs at once.
# (default: 2; environment only)
# MAX_CONCURRENT_JOBS=2

# Seconds between polls of the jobs table.
# (default: 2.0; environment only)
# WORKER_POLL_INTERVAL_SECONDS=2.0


# ──────────────────────────────────────────────────────────────────────────
# LIMITS — Size ceilings that protect memory and the database.
# Without it: Nothing turns off. These are refusals, not features: exceeding
# one is always a stated rejection, never a silent truncation.
#
# These are infrastructure ceilings and are NOT the commercial tier limits.
# Per-tenant allowances live in `backend/entitlements/plans.py`.
#
# Environment only — the panel reports these, never writes them.
# ──────────────────────────────────────────────────────────────────────────
# Hard ceiling on an uploaded file, above the tier's own limit.
# (default: 200; environment only)
# MAX_UPLOAD_SIZE_MB=200

# Rows the in-app dataset editor will open. Checked from stored row_count
# BEFORE reading the file, so a huge file is never loaded into memory to
# find out it is too big.
# (default: 50000; environment only)
# DATASET_EDITOR_MAX_ROWS=50000

# Same guard, by file size.
# (default: 10; environment only)
# DATASET_EDITOR_MAX_MB=10

# Row ceiling when snapshotting a SQL data source into a CSV dataset.
# Exceeding it is a refusal, never a truncation.
# (default: 500000; environment only)
# SQL_MATERIALIZE_MAX_ROWS=500000

# How much worse (in percent, relative) a session's forecast must be doing
# against real sales than it did at training time before the app raises its
# one 'forecast is degrading' alert. 25 means a realised WAPE of 25% over
# the training WAPE (and at least 5 points worse); it is a notification
# only, nothing retrains by itself.
# (default: 25.0; environment only)
# ACCURACY_DEGRADATION_THRESHOLD_PCT=25.0


# ──────────────────────────────────────────────────────────────────────────
# API_SURFACE — Public-API-only mode.
# Without it: With it on, this instance serves ONLY the endpoints a
# customer's own system is invited to call, plus /health. The web app served
# from this host stops working entirely — which is the point: it is meant to
# run as a second instance of the same image.
#
# What it does NOT buy: isolation from the database. Both instances still
# share one Postgres, so a database problem takes down the customer's
# integration and the app together.
#
# Environment only — the panel reports these, never writes them.
# ──────────────────────────────────────────────────────────────────────────
# Serve only the public integration surface on this instance.
# (default: false; environment only)
# PUBLIC_API_ONLY=false


# ──────────────────────────────────────────────────────────────────────────
# OPERATIONS — Thresholds behind the installation status panel (queue, worker, disk, backup, latency).
# Without it: Nothing turns off. These decide when `GET /service-config/ops`
# and the 'Installation status' panel call a reading degraded; they never
# block a request or a job.
#
# These are the service-level objectives of the installation, in one place.
# Request latency is measured in the API process that answers
# `/service-config/ops` (an in-memory rolling window, lost on restart);
# queue, worker heartbeat and failed jobs are read from the database and
# therefore cover every process. The backup readings need the backup
# script's success marker to be visible to the API container: see
# `deploy/RESTORE.md`.
#
# Environment only — the panel reports these, never writes them.
# ──────────────────────────────────────────────────────────────────────────
# A job that has been QUEUED longer than this many minutes makes the queue
# degraded.
# (default: 10.0; environment only)
# OPS_QUEUE_WAIT_DEGRADED_MINUTES=10

# A job RUNNING longer than this many minutes is reported as possibly stuck.
# (default: 180.0; environment only)
# OPS_RUNNING_JOB_DEGRADED_MINUTES=180

# The worker's last heartbeat older than this many seconds means nobody is
# claiming jobs.
# (default: 120.0; environment only)
# OPS_WORKER_HEARTBEAT_STALE_SECONDS=120

# Free space below this percentage on the storage or backup volume is
# degraded.
# (default: 10.0; environment only)
# OPS_DISK_FREE_MIN_PERCENT=10

# The last successful backup older than this many hours is degraded. 36
# tolerates one missed night.
# (default: 36.0; environment only)
# OPS_BACKUP_MAX_AGE_HOURS=36

# Database connections in use, as a percentage of the pool, at or above
# which the pool is degraded.
# (default: 85.0; environment only)
# OPS_POOL_SATURATION_PERCENT=85

# A route family whose p95 latency (recent window) exceeds this many
# milliseconds is degraded.
# (default: 3000.0; environment only)
# OPS_LATENCY_SLO_MS=3000

# Statements slower than this many milliseconds are counted as slow queries
# (count and worst only; parameters are never kept).
# (default: 1000.0; environment only)
# OPS_SLOW_QUERY_MS=1000

# Path, as the API container sees it, of the JSON success marker the nightly
# backup script writes. Empty means the backup readings report 'unknown'.
# (environment only)
# BACKUP_STATUS_PATH=/backups/last_success.json

# Folder the backups are written to, as the API container sees it; used to
# report its free disk space. Empty skips that reading.
# (environment only)
# BACKUP_DIR=/backups
