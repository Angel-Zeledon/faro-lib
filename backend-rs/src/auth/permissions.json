{
  "version": 1,
  "permissions": [
    {"name": "view_forecasts", "description": "Read sessions, forecasts and results"},
    {"name": "run_training", "description": "Start training, back-tests and re-forecasts"},
    {"name": "manage_sessions", "description": "Create and change sessions, scenarios, adjustments and spike edits"},
    {"name": "export_data", "description": "Download reports, artifacts and data exports"},
    {"name": "view_inventory", "description": "Read stock, purchase orders, suppliers and commitments"},
    {"name": "manage_inventory", "description": "Change stock, purchase orders, suppliers, budgets and commitments"},
    {"name": "approve_purchases", "description": "Approve or reject purchase orders and demand plans"},
    {"name": "view_analysts", "description": "Read analyst chats and documents"},
    {"name": "run_analysts", "description": "Ask the analyst and manage its documents"},
    {"name": "view_data_sources", "description": "Read data sources and datasets"},
    {"name": "manage_data_sources", "description": "Create, change and delete data sources"},
    {"name": "view_users", "description": "Read users and roles"},
    {"name": "manage_users", "description": "Invite, change and deactivate users"},
    {"name": "manage_roles", "description": "Create custom roles and assign them"},
    {"name": "manage_settings", "description": "Change tenant settings, thresholds, warehouses, approval rules and billing"},
    {"name": "manage_integrations", "description": "Manage API keys, webhooks and inbound email"},
    {"name": "view_audit", "description": "Read the audit trail"}
  ],
  "legacy_permissions": [
    "view_forecasts", "run_training", "manage_sessions", "export_data",
    "view_inventory", "manage_inventory",
    "view_analysts", "run_analysts",
    "view_data_sources", "manage_data_sources",
    "view_users", "manage_users"
  ],
  "rules": [
    {"class": "write", "prefix": "/auth", "permission": "open"},
    {"class": "write", "prefix": "/scim", "permission": "open"},
    {"class": "write", "prefix": "/billing/stripe", "permission": "open"},
    {"class": "write", "prefix": "/billing/paypal", "permission": "open"},
    {"class": "write", "prefix": "/inbound/email", "permission": "open"},
    {"class": "write", "prefix": "/whatsapp", "permission": "open"},
    {"class": "write", "prefix": "/supplier-portal", "permission": "open"},
    {"class": "write", "prefix": "/trial", "permission": "open"},
    {"class": "write", "prefix": "/feedback", "permission": "open"},
    {"class": "write", "prefix": "/me", "permission": "open"},
    {"class": "write", "prefix": "/users/me", "permission": "open"},
    {"class": "write", "prefix": "/alerts", "permission": "open"},
    {"class": "write", "prefix": "/messages", "permission": "open"},
    {"class": "write", "prefix": "/entitlements", "permission": "open"},
    {"class": "write", "prefix": "/mcp", "permission": "open"},

    {"class": "write", "prefix": "/sessions", "permission": "manage_sessions"},
    {"class": "write", "prefix": "/sessions/{}/train", "permission": "run_training"},
    {"class": "write", "prefix": "/sessions/{}/backtest", "permission": "run_training"},
    {"class": "write", "prefix": "/sessions/{}/reforecast", "permission": "run_training"},
    {"class": "write", "prefix": "/sessions/{}/predict", "permission": "run_training"},
    {"class": "write", "prefix": "/sessions/{}/drift", "permission": "run_training"},
    {"class": "write", "prefix": "/sessions/{}/analyst", "permission": "run_analysts"},
    {"class": "write", "prefix": "/sessions/{}/reports", "permission": "export_data"},
    {"class": "write", "prefix": "/jobs", "permission": "run_training"},
    {"class": "write", "prefix": "/demo", "permission": "manage_sessions"},
    {"class": "write", "prefix": "/scenarios", "permission": "manage_sessions"},
    {"class": "write", "prefix": "/sku-analogies", "permission": "manage_sessions"},
    {"class": "write", "prefix": "/spike-edits", "permission": "manage_sessions"},

    {"class": "write", "prefix": "/ai", "permission": "run_analysts"},
    {"class": "write", "prefix": "/analyst", "permission": "run_analysts"},
    {"class": "write", "prefix": "/documents", "permission": "run_analysts"},

    {"class": "write", "prefix": "/datasets", "permission": "manage_data_sources"},
    {"class": "write", "prefix": "/data-sources", "permission": "manage_data_sources"},
    {"class": "write", "prefix": "/data-sources/{}/export-query", "permission": "export_data"},

    {"class": "write", "prefix": "/inventory", "permission": "manage_inventory"},
    {"class": "write", "prefix": "/committed-demand", "permission": "manage_inventory"},
    {"class": "write", "prefix": "/supply-contracts", "permission": "manage_inventory"},
    {"class": "write", "prefix": "/demand-plans", "permission": "manage_inventory"},
    {"class": "write", "prefix": "/inventory/po/{}/approval/approve", "permission": "approve_purchases"},
    {"class": "write", "prefix": "/inventory/po/{}/approval/reject", "permission": "approve_purchases"},
    {"class": "write", "prefix": "/demand-plans/{}/approve", "permission": "approve_purchases"},
    {"class": "write", "prefix": "/demand-plans/{}/reject", "permission": "approve_purchases"},

    {"class": "write", "prefix": "/inventory/po-approval", "permission": "manage_settings"},
    {"class": "write", "prefix": "/inventory/signal-thresholds", "permission": "manage_settings"},
    {"class": "write", "prefix": "/inventory/service-level-classes", "permission": "manage_settings"},
    {"class": "write", "prefix": "/inventory/warehouses", "permission": "manage_settings"},
    {"class": "write", "prefix": "/planning", "permission": "manage_settings"},
    {"class": "write", "prefix": "/tenant", "permission": "manage_settings"},
    {"class": "write", "prefix": "/service-config", "permission": "manage_settings"},
    {"class": "write", "prefix": "/billing", "permission": "manage_settings"},

    {"class": "write", "prefix": "/users", "permission": "manage_users"},
    {"class": "write", "prefix": "/roles", "permission": "manage_roles"},
    {"class": "write", "prefix": "/users/{}/custom-role", "permission": "manage_roles"},

    {"class": "write", "prefix": "/api-keys", "permission": "manage_integrations"},
    {"class": "write", "prefix": "/webhooks", "permission": "manage_integrations"},
    {"class": "write", "prefix": "/inbound-email", "permission": "manage_integrations"},

    {"class": "read", "prefix": "/sessions", "permission": "view_forecasts"},
    {"class": "read", "prefix": "/sessions/{}/reports", "permission": "export_data"},
    {"class": "read", "prefix": "/sessions/{}/artifacts", "permission": "export_data"},
    {"class": "read", "prefix": "/sessions/{}/export-config", "permission": "export_data"},
    {"class": "read", "prefix": "/sessions/{}/analyst", "permission": "view_analysts"},
    {"class": "read", "prefix": "/analyst", "permission": "view_analysts"},
    {"class": "read", "prefix": "/documents", "permission": "view_analysts"},
    {"class": "read", "prefix": "/datasets", "permission": "view_data_sources"},
    {"class": "read", "prefix": "/data-sources", "permission": "view_data_sources"},
    {"class": "read", "prefix": "/inventory", "permission": "view_inventory"},
    {"class": "read", "prefix": "/inventory/report", "permission": "export_data"},
    {"class": "read", "prefix": "/inventory/status/export-po", "permission": "export_data"},
    {"class": "read", "prefix": "/committed-demand", "permission": "view_inventory"},
    {"class": "read", "prefix": "/supply-contracts", "permission": "view_inventory"},
    {"class": "read", "prefix": "/demand-plans", "permission": "view_inventory"},
    {"class": "read", "prefix": "/tenant/export", "permission": "export_data"},
    {"class": "read", "prefix": "/users", "permission": "view_users"},
    {"class": "read", "prefix": "/users/me", "permission": "open"},
    {"class": "read", "prefix": "/roles", "permission": "view_users"},
    {"class": "read", "prefix": "/roles/me", "permission": "open"},
    {"class": "read", "prefix": "/audit", "permission": "view_audit"},
    {"class": "read", "prefix": "/audit/filters", "permission": "open"},
    {"class": "read", "prefix": "/api-keys", "permission": "manage_integrations"},
    {"class": "read", "prefix": "/webhooks", "permission": "manage_integrations"},
    {"class": "read", "prefix": "/inbound-email", "permission": "manage_integrations"},
    {"class": "read", "prefix": "/service-config", "permission": "manage_settings"},
    {"class": "read", "prefix": "/service-config/capabilities", "permission": "open"},
    {"class": "read", "prefix": "/billing/status", "permission": "manage_settings"}
  ],
  "probes": [
    ["POST", "/sessions", "manage_sessions"],
    ["POST", "/sessions/{session_id}/train", "run_training"],
    ["POST", "/sessions/{id}/analyst/query", "run_analysts"],
    ["GET", "/sessions/{session_id}/artifacts/download/{artifact_path:path}", "export_data"],
    ["GET", "/sessions/summary", "view_forecasts"],
    ["POST", "/inventory/po/{po_log_id}/approval/approve", "approve_purchases"],
    ["POST", "/inventory/po/{po_log_id}/approval/request", "manage_inventory"],
    ["POST", "/inventory/po/{po_log_id}/mark-paid", "manage_inventory"],
    ["PUT", "/inventory/signal-thresholds", "manage_settings"],
    ["GET", "/inventory/signal-thresholds", "view_inventory"],
    ["PUT", "/users/{user_id}/custom-role", "manage_roles"],
    ["PATCH", "/users/{user_id}", "manage_users"],
    ["PATCH", "/users/me", "open"],
    ["GET", "/users/me", "open"],
    ["GET", "/users", "view_users"],
    ["POST", "/roles", "manage_roles"],
    ["DELETE", "/roles/{role_id}", "manage_roles"],
    ["GET", "/roles", "view_users"],
    ["GET", "/roles/me", "open"],
    ["POST", "/auth/login", "open"],
    ["GET", "/audit", "view_audit"],
    ["GET", "/audit/filters", "open"],
    ["GET", "/me/activity", "none"],
    ["GET", "/models", "none"],
    ["POST", "/brand-new-router/things", "none"],
    ["GET", "/service-config/capabilities", "open"],
    ["GET", "/service-config/tenant", "manage_settings"],
    ["POST", "/webhooks/{webhook_id}/rotate-secret", "manage_integrations"],
    ["POST", "/sessions-archive", "none"]
  ]
}
